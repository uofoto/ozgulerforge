{
  "name": "Ses Cebi",
  "short_name": "Ses Cebi",
  "description": "ozguler forge Ses Cebi Premium — kişisel ses arşivi, çevrimdışı dinleme ve ses kesme stüdyosu.",
  "id": "./?ses-cebi=2",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fafaf9",
  "theme_color": "#0f766e",
  "lang": "tr",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "music",
    "utilities"
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": [
            "audio/*",
            "video/*",
            ".mp3",
            ".m4a",
            ".wav",
            ".ogg",
            ".aac",
            ".flac",
            ".mp4",
            ".m4v",
            ".mov",
            ".webm",
            ".mkv"
          ]
        }
      ]
    }
  }
}